{
  "id": "earthquake_school",
  "version": "3.1.0",
  "title": "上課鐘響後",
  "hazard": "earthquake",
  "locationProfile": "school_classroom",
  "opening": "上午十點，我和同學小維在教室上課。桌面突然晃起來，我聽見物品碰撞的聲音。老師就在教室前方，我看見小維轉身望向出口。",
  "notice": "演練依消防與校園防災原則設計；實際狀況依校方及救援人員指示。",
  "learningObjectives": [
    "強烈搖晃時先趴下、掩護、穩住，不急著往外跑",
    "主要搖晃停止後，依教師與校方確認的路線疏散",
    "抵達集合點接受點名，不搭電梯也不返回拿物品"
  ],
  "commonMisconceptions": [
    "地震一來就立刻往外跑",
    "搭電梯可以更快離開",
    "疏散後可以回教室拿手機或書包"
  ],
  "reflectionQuestions": [
    "如果指定樓梯受損，你應該依靠誰提供替代路線？",
    "為什麼抵達集合點後不能自行離隊？"
  ],
  "questionPattern": "[?？]|是否|是不是|能不能|可不可以|怎麼|如何|為什麼|嗎|要不要|如果|假如|假設",
  "negationPattern": "(?:不想|不打算|不會|不要|不能|不可|沒有|沒|不|別|勿|避免)[^，。；、!?！？]{0,5}$",
  "splitPattern": "[，。；、,;!！\\n]|然後|接著|但是|但|而且|並且|也|再來",
  "initialNode": "shaking",
  "initialState": {
    "physicalStatus": "EXPOSED",
    "resources": {
      "battery": 80,
      "water": 1,
      "energy": 100
    },
    "facts": {
      "shaking": true,
      "stairsChecked": false,
      "returnClearance": false
    },
    "exposure": {
      "trauma": 0
    }
  },
  "actions": [
    {
      "id": "drop_cover_hold",
      "label": "趴下、掩護、穩住",
      "pattern": "趴下.*(?:桌下|掩護).*(?:頭頸|頭部|抓穩|穩住)|躲到桌下.*保護.*(?:頭|頸)",
      "sourceIds": [
        "source-0"
      ]
    },
    {
      "id": "wait_stop",
      "label": "等待主要搖晃停止",
      "pattern": "等待.*(?:搖晃|地震).*(?:停止|結束)|搖晃停止.*再",
      "sourceIds": [
        "source-0"
      ]
    },
    {
      "id": "run_elevator",
      "label": "搖晃時衝向電梯",
      "pattern": "衝去搭電梯|(?:跑|衝|奔).*(?:升降機|電梯)",
      "sourceIds": [
        "source-0"
      ],
      "consequence": "你在搖晃時衝向電梯。演練因掉落物、跌倒與受困風險結束。",
      "teaching": "正在搖晃時先保護頭頸並依老師指示，等主要搖晃停止。",
      "examples": [
        "我衝去搭電梯"
      ],
      "hazardMode": "IMMEDIATE",
      "consequenceTemplate": "我在搖晃中往電梯跑。身邊仍在晃，我可能跌倒、被掉落物砸到，也可能困在電梯裡。"
    },
    {
      "id": "run_outside",
      "label": "搖晃中跑到戶外",
      "pattern": "(?:搖晃|地震).*(?:衝|跑).*(?:外面|戶外)|(?:地在晃|還在搖).*(?:跑出|衝出)",
      "sourceIds": [
        "source-0"
      ],
      "consequence": "你在搖晃仍持續時跑向戶外。演練因移動時的掉落物與跌倒風險結束。",
      "teaching": "主要搖晃停止前先就地保護頭頸，之後依老師指示疏散。",
      "examples": [
        "我在搖晃時跑到外面"
      ],
      "hazardMode": "EXPOSURE"
    },
    {
      "id": "follow_stairs",
      "label": "依教師指示走安全樓梯疏散",
      "pattern": "(?:聽從|依照|跟隨).*(?:老師|教師|校方).*(?:樓梯|疏散)|走樓梯.*疏散",
      "requires": {
        "facts": {
          "shaking": false,
          "stairsChecked": true
        }
      },
      "sourceIds": [
        "source-0"
      ]
    },
    {
      "id": "assembly",
      "label": "至集合點點名且不返回",
      "pattern": "(?:到|前往).*(?:集合點|操場).*(?:點名|清點)|集合點.*不返回",
      "sourceIds": [
        "source-0"
      ]
    },
    {
      "id": "return_bag",
      "label": "返回教室拿物品",
      "pattern": "返回.*教室.*(?:拿|找).*(?:手機|書包|東西)",
      "sourceIds": [
        "source-0"
      ],
      "unsafeWhenBlocked": true,
      "blockedMessage": "我留在老師帶隊的路線，返回教室的動作被攔下。",
      "hazardMode": "EXPOSURE",
      "blockedAfterInjury": "S1"
    },
    {
      "id": "jump_window",
      "label": "從高樓窗戶跳下",
      "pattern": "(?:從|自).*(?:窗戶|窗子).*(?:跳|翻)|跳窗|跳樓",
      "sourceIds": [
        "source-0"
      ],
      "hazardMode": "IMMEDIATE",
      "consequenceTemplate": "我選擇從三樓窗戶跳下。窗外離地很遠，我可能從高處墜落。"
    },
    {
      "id": "emotion_supportive",
      "label": "我聽見小維回了一聲，表示已聽見。",
      "pattern": "^(?:我聽到了我在附近我們先在各自的位置護住頭頸|我知道你擔心家人等老師確認動線後我陪你聽指示|我會用聲音回應你到集合點後我可以陪你向老師報到)$",
