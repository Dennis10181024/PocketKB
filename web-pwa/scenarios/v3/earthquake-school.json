      "sourceIds": [
        "source-0"
      ]
    },
    {
      "id": "padding_head",
      "label": "用手邊物品護住頭頸",
      "pattern": "用(?:手邊|手上)?(?:書包|防災頭套|軟墊).*(?:護|遮).*(?:頭|頸)",
      "sourceIds": [
        "campus-evac"
      ],
      "effect": "我把手邊的緩衝物靠近頭頸，仍留在目前的位置。"
    },
    {
      "id": "walk_steadily",
      "label": "依隊伍步行且避免推擠",
      "pattern": "(?:不推擠|不推不跑|依序步行|排隊慢慢走|保持隊伍間距)",
