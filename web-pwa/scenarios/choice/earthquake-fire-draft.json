  "decisions": [
    {"id":"quakefire_cover","prompt":"屋子開始左右晃，架上的杯子往外滑。我的第一步是什麼？","when":{"clock":{"eq":0}},"options":[{"id":"quakefire_cover_ok","text":"我到堅固桌下護頭，抓穩桌腳。","class":"correct","safety":"safe","sourceIds":["eq"],"steps":[{"kind":"principle","id":"quakefire_cover_act_ok"}],"cues":[],"effect":{},"narration":"option_quakefire_cover_ok"},{"id":"quakefire_cover_myth","text":"我伸手接住架上杯子，叫怡安也過來。","class":"misconception","safety":"unsafe","sourceIds":["eq"],"steps":[{"kind":"hazard","id":"quakefire_cover_act_myth"}],"cues":[],"effect":{},"narration":"option_quakefire_cover_myth"},{"id":"quakefire_cover_risk","text":"我扶著牆往門口跑，叫怡安拿鑰匙。","class":"risk_or_delay","safety":"unsafe","sourceIds":["eq"],"steps":[{"kind":"hazard","id":"quakefire_cover_act_risk"}],"cues":[],"effect":{},"narration":"option_quakefire_cover_risk"}]},
    {"id":"quakefire_assess","prompt":"搖晃暫時停了，走道另一頭有焦味。屋內地板也散著物品。我先判斷什麼？","when":{"clock":{"eq":1}},"options":[{"id":"quakefire_assess_ok","text":"我從原處查看煙況、人和可用動線。","class":"correct","safety":"safe","sourceIds":["cause"],"steps":[{"kind":"principle","id":"quakefire_assess_act_ok"}],"cues":[],"effect":{},"narration":"option_quakefire_assess_ok"},{"id":"quakefire_assess_myth","text":"我叫怡安去聞，自己留在門邊。","class":"misconception","safety":"unsafe","sourceIds":["cause"],"steps":[{"kind":"hazard","id":"quakefire_assess_act_myth"}],"cues":[],"effect":{},"narration":"option_quakefire_assess_myth"},{"id":"quakefire_assess_risk","text":"我回內側先找手機，再跟怡安走出去看。","class":"risk_or_delay","safety":"unsafe","sourceIds":["cause"],"steps":[{"kind":"hazard","id":"quakefire_assess_act_risk"}],"cues":[],"effect":{},"narration":"option_quakefire_assess_risk"}]},
    {"id":"quakefire_gas","prompt":"離廚房一段距離有疑似瓦斯味，可通行的前側沒有煙。怡安伸手要開燈，我怎麼回她？","when":{"clock":{"eq":2}},"options":[{"id":"quakefire_gas_ok","text":"我勸怡安把手收回，沿無煙的一側走。","class":"correct","safety":"safe","sourceIds":["gas"],"steps":[{"kind":"principle","id":"quakefire_gas_act_ok"}],"cues":[],"effect":{},"narration":"option_quakefire_gas_ok"},{"id":"quakefire_gas_myth","text":"我請她開廚房燈，先查看爐子。","class":"misconception","safety":"unsafe","sourceIds":["gas"],"steps":[{"kind":"hazard","id":"quakefire_gas_act_myth"}],"cues":[],"effect":{},"narration":"option_quakefire_gas_myth"},{"id":"quakefire_gas_risk","text":"我往廚房裡走去查味道，再示意她等候。","class":"risk_or_delay","safety":"unsafe","sourceIds":["gas"],"steps":[{"kind":"hazard","id":"quakefire_gas_act_risk"}],"cues":[],"effect":{},"narration":"option_quakefire_gas_risk"}]},
    {"id":"quakefire_route","prompt":"門外有兩條方向。內側出口遠端已見煙，前側的樓梯門外還看得清。我選哪邊？","when":{"clock":{"eq":3}},"options":[{"id":"quakefire_route_ok","text":"我走向看得清的樓梯入口，沿途再確認。","class":"correct","safety":"safe","sourceIds":["fire"],"steps":[{"kind":"principle","id":"quakefire_route_act_ok"}],"cues":[],"effect":{},"narration":"option_quakefire_route_ok"},{"id":"quakefire_route_myth","text":"我走熟悉的內側，想趁還認得路出去。","class":"misconception","safety":"unsafe","sourceIds":["fire"],"steps":[{"kind":"hazard","id":"quakefire_route_act_myth"}],"cues":[],"effect":{},"narration":"option_quakefire_route_myth"},{"id":"quakefire_route_risk","text":"我留在樓梯口看舊圖，再聽怡安的想法。","class":"risk_or_delay","safety":"unsafe","sourceIds":["fire"],"steps":[{"kind":"hazard","id":"quakefire_route_act_risk"}],"cues":[],"effect":{},"narration":"option_quakefire_route_risk"}]},
    {"id":"quakefire_smoke","prompt":"走到可見範圍邊緣，樓梯門外忽然被濃煙遮住。我退後還能回到較清楚的一側。我怎麼選？","when":{"clock":{"eq":4}},"options":[{"id":"quakefire_smoke_ok","text":"我退回可隔煙的房內，把門帶緊。","class":"correct","safety":"safe","sourceIds":["fire"],"steps":[{"kind":"principle","id":"quakefire_smoke_act_ok"}],"cues":[],"effect":{},"narration":"option_quakefire_smoke_ok"},{"id":"quakefire_smoke_myth","text":"我靠樓梯邊等一陣，看看煙會不會變薄。","class":"misconception","safety":"unsafe","sourceIds":["fire"],"steps":[{"kind":"hazard","id":"quakefire_smoke_act_myth"}],"cues":[],"effect":{},"narration":"option_quakefire_smoke_myth"},{"id":"quakefire_smoke_risk","text":"我貼著牆進樓梯間，想摸出下一層。","class":"risk_or_delay","safety":"unsafe","sourceIds":["fire"],"steps":[{"kind":"hazard","id":"quakefire_smoke_act_risk"}],"cues":[],"effect":{},"narration":"option_quakefire_smoke_risk"}]},
