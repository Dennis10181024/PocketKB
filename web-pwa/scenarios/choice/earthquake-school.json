      {"id":"wait","sourceIds":["cwa-school"],"when":{"always":true},"review":{"why":"持續搖晃時移動可能遇到墜落物。","tip":"停震後再依指示疏散。","eligibleWhen":{"always":true},"priority":5},"normal":{"narration":"principle_wait","effect":{"set":{"facts.waited":true},"add":{}}}},
