      {"id":"triangle","sourceIds":["ntfd-cover"],"when":{"fact":"shaking","eq":true},"review":{"why":"靠在櫃旁會暴露在落物下。","tip":"靠近堅固桌子時，趴下、掩護並抓牢桌腳。","eligibleWhen":{"always":true},"priority":5,"principleId":"cover"},"normal":{"narration":"hazard_triangle","effect":{"set":{"facts.delayed":true},"add":{},"delay":"把靠在櫃旁當成掩護"}}},
