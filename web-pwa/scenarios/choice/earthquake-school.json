      {"id":"cover","sourceIds":["ntfd-cover"],"when":{"fact":"shaking","eq":true},"review":{"why":"桌下的掩護可減少掉落物造成的傷害。","tip":"一搖晃就趴下、掩護、穩住。","eligibleWhen":{"fact":"shaking","eq":true},"priority":5},"normal":{"narration":"principle_cover","effect":{"set":{"facts.covered":true},"add":{}}},"cases":[{"when":{"has":{"set":"turnCues","id":"no_grip"}},"result":{"narration":"option_cover_only","effect":{"set":{"facts.covered":true},"add":{}}}}]},
