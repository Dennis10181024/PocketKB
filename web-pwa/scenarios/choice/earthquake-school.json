      {"id":"head","sourceIds":["moi-earthquake"],"when":{"not":{"fact":"shaking","eq":true}},"review":{"why":"疏散時護頭可減少落物風險。","tip":"停震後疏散時護頭，留意落物。","eligibleWhen":{"always":true},"priority":5},"normal":{"narration":"principle_head","effect":{"set":{"facts.head":true},"add":{}}}},
      {"id":"orderly","sourceIds":["moi-earthquake"],"when":{"not":{"fact":"shaking","eq":true}},"review":{"why":"留出距離可降低推擠和跌倒風險。","tip":"走樓梯時不推不跑，與前方留出距離。","eligibleWhen":{"always":true},"priority":5},"normal":{"narration":"principle_orderly","effect":{"set":{"facts.orderly":true},"add":{}}}},
      {"id":"stairs","sourceIds":["moi-earthquake"],"when":{"not":{"fact":"shaking","eq":true}},"review":{"why":"電梯可能停在樓層間。","tip":"停震後走可通行的樓梯疏散。","eligibleWhen":{"always":true},"priority":5},"normal":{"narration":"principle_stairs","effect":{"set":{"facts.stairs":true},"add":{}}}},
