  "decisions": [
    {"id":"main","prompt":"教室突然劇烈搖晃，桌椅開始移動。我第一步做什麼？","when":{"clock":{"eq":0}},"options":[{"id":"take_cover","text":"我趴到桌下護頭頸，牢牢抓穩桌腳。","class":"correct","safety":"safe","sourceIds":["cwa-school","ntfd-cover"],"steps":[{"kind":"principle","id":"cover"}],"cues":[],"effect":{"set":{},"add":{}},"narration":"option_take_cover"},{"id":"use_triangle","text":"我蹲進櫃子旁的空隙，扶著櫃子穩住。","class":"misconception","safety":"unsafe","sourceIds":["cwa-school","ntfd-cover"],"steps":[{"kind":"hazard","id":"triangle"}],"cues":[],"effect":{"set":{},"add":{}},"narration":"option_use_triangle"},{"id":"rush_door","text":"我扶著桌沿站起來，趁門開著跑到走廊。","class":"risk_or_delay","safety":"unsafe","sourceIds":["cwa-school"],"steps":[{"kind":"hazard","id":"rush_open"}],"cues":[],"effect":{"set":{},"add":{}},"narration":"option_rush_door"},{"id":"cover_only","text":"我縮進桌下，雙手抱住頭頸擋落物。","class":"partial","safety":"safe","sourceIds":["cwa-school","ntfd-cover"],"steps":[{"kind":"principle","id":"cover"}],"cues":["no_grip"],"effect":{"set":{},"add":{}},"narration":"option_cover_only","missingStep":"護住頭頸後，還要抓牢桌腳，免得桌子在搖晃時滑開。"}]},
    {"id":"companion","prompt":"小維說：「我想拉開後門，叫隔壁班一起走。」我怎麼回他？","when":{"clock":{"eq":1}},"options":[{"id":"reassure_peer","text":"我請小維留在桌下，陪他等搖晃停止。","class":"correct","safety":"safe","sourceIds":["cwa-school"],"steps":[{"kind":"principle","id":"stop_npc"},{"kind":"principle","id":"reassure"},{"kind":"principle","id":"wait"}],"cues":[],"effect":{"set":{},"add":{}},"narration":"option_reassure_peer"},{"id":"wait_peer","text":"我叫小維先走到門邊，扶住門框等開門。","class":"misconception","safety":"unsafe","sourceIds":["cwa-school"],"steps":[{"kind":"hazard","id":"send_peer_to_door"}],"cues":[],"effect":{"set":{},"add":{}},"narration":"option_wait_peer"},{"id":"watch_door","text":"我招手叫小維跟來，跑到門邊看隔壁班。","class":"risk_or_delay","safety":"unsafe","sourceIds":["cwa-school"],"steps":[{"kind":"hazard","id":"rush_open"}],"cues":["invite"],"effect":{"set":{},"add":{}},"narration":"option_watch_door"},{"id":"stop_peer","text":"我示意小維回桌下，自己也留在桌邊。","class":"partial","safety":"safe","sourceIds":["cwa-school"],"steps":[{"kind":"principle","id":"stop_npc"}],"cues":[],"effect":{"set":{},"add":{}},"narration":"option_stop_peer","missingStep":"勸小維回到桌下後，回應他的擔心，陪他等搖晃停止。"}]},
    {"id":"aftershock","prompt":"剛要起身，教室又晃了起來，桌腳在地上滑。我怎麼應對？","when":{"clock":{"eq":2}},"options":[{"id":"cover_aftershock","text":"我趴回桌下護頭頸，抓牢桌腳等震動過去。","class":"correct","safety":"safe","sourceIds":["cwa-school"],"steps":[{"kind":"principle","id":"aftershock_cover"}],"cues":[],"effect":{"set":{},"add":{}},"narration":"option_cover_aftershock"},{"id":"stand_by_desk","text":"我移到櫃旁蹲低，扶櫃等搖晃變小。","class":"misconception","safety":"unsafe","sourceIds":["cwa-school","ntfd-cover"],"steps":[{"kind":"hazard","id":"triangle"}],"cues":[],"effect":{"set":{},"add":{}},"narration":"option_stand_by_desk"},{"id":"rush_aftershock","text":"我扶著桌沿起身，趁空檔跑出教室。","class":"risk_or_delay","safety":"unsafe","sourceIds":["cwa-school"],"steps":[{"kind":"hazard","id":"rush_open"}],"cues":[],"effect":{"set":{},"add":{}},"narration":"option_rush_aftershock"},{"id":"climb_window","text":"我翻過窗台，想沿低處平台避開落物。","class":"risk_or_delay","safety":"unsafe","sourceIds":["cwa-school"],"steps":[{"kind":"hazard","id":"jump_window"}],"cues":[],"effect":{"set":{},"add":{}},"narration":"option_climb_window"}]},
    {"id":"stairs","prompt":"老師說可以疏散。樓梯前已排了幾個班，另一側有電梯。我怎麼離開？","when":{"clock":{"eq":3}},"options":[{"id":"orderly_stairs","text":"我護好頭頸，留出距離跟隊走樓梯。","class":"correct","safety":"safe","sourceIds":["cwa-school","moi-earthquake"],"steps":[{"kind":"principle","id":"head"},{"kind":"principle","id":"orderly"},{"kind":"principle","id":"stairs"}],"cues":[],"effect":{"set":{},"add":{}},"narration":"option_orderly_stairs"},{"id":"rush_stairs","text":"我貼著扶手快步下樓，趕在後隊之前。","class":"misconception","safety":"unsafe","sourceIds":["cwa-school","moi-earthquake"],"steps":[{"kind":"hazard","id":"pushing"}],"cues":[],"effect":{"set":{},"add":{}},"narration":"option_rush_stairs"},{"id":"take_elevator","text":"我改走電梯，按一樓去外面找隊伍。","class":"risk_or_delay","safety":"unsafe","sourceIds":["cwa-school"],"steps":[{"kind":"hazard","id":"elevator"}],"cues":[],"effect":{"set":{},"add":{}},"narration":"option_take_elevator"},{"id":"stairs_only","text":"我跟著班級走樓梯，和前面留好距離。","class":"partial","safety":"safe","sourceIds":["cwa-school","moi-earthquake"],"steps":[{"kind":"principle","id":"orderly"},{"kind":"principle","id":"stairs"}],"cues":[],"effect":{"set":{},"add":{}},"narration":"option_stairs_only","missingStep":"跟隊走樓梯時，也要護住頭頸，減少掉落物傷害。"}]},
    {"id":"outside","prompt":"出口外牆掉了幾塊碎片，前方還垂著一條線。我選哪條路？","when":{"clock":{"eq":4}},"options":[{"id":"avoid_wire","text":"我繞開外牆和電線，往操場空地走。","class":"correct","safety":"safe","sourceIds":["cwa-school","moi-earthquake"],"steps":[{"kind":"principle","id":"open_area"}],"cues":[],"effect":{"set":{},"add":{}},"narration":"option_avoid_wire"},{"id":"follow_wall","text":"我貼著外牆走，順著牆繞開正前方的線。","class":"misconception","safety":"unsafe","sourceIds":["cwa-school","moi-earthquake"],"steps":[{"kind":"hazard","id":"stay_at_wall"}],"cues":["wall"],"effect":{"set":{},"add":{}},"narration":"option_follow_wall"},{"id":"move_wire","text":"我走上前抓住電線，挪開替同學開路。","class":"risk_or_delay","safety":"unsafe","sourceIds":["cwa-school","moi-earthquake"],"steps":[{"kind":"hazard","id":"wire"}],"cues":[],"effect":{"set":{},"add":{}},"narration":"option_move_wire"}]},
    {"id":"assembly","prompt":"操場上幾個班正在集合，熟識的同學朝我招手。我在哪裡等？","when":{"clock":{"eq":5}},"options":[{"id":"join_class","text":"我找到本班老師，回到原班位置等候。","class":"correct","safety":"safe","sourceIds":["cwa-school","moi-earthquake"],"steps":[{"kind":"principle","id":"stay_group"}],"cues":[],"effect":{"set":{},"add":{}},"narration":"option_join_class"},{"id":"join_other_class","text":"我先到朋友班上，站到隊尾等老師點名。","class":"misconception","safety":"unsafe","sourceIds":["cwa-school","moi-earthquake"],"steps":[{"kind":"hazard","id":"leave_assembly"}],"cues":["leave"],"effect":{"set":{},"add":{}},"narration":"option_join_other_class"},{"id":"retrieve_phone","text":"我先回教室找手機，拿到後趕回操場。","class":"risk_or_delay","safety":"unsafe","sourceIds":["cwa-school","moi-earthquake"],"steps":[{"kind":"hazard","id":"collect"}],"cues":["leave"],"effect":{"set":{},"add":{}},"narration":"option_retrieve_phone"}]},
    {"id":"roll_call","prompt":"老師正喊我的名字，小維還沒被確認。我回應什麼？","when":{"clock":{"gte":6}},"options":[{"id":"answer_roll","text":"我應聲確認到場，回報小維的位置和傷勢。","class":"correct","safety":"safe","sourceIds":["cwa-school","moi-earthquake"],"steps":[{"kind":"principle","id":"roll_call"}],"cues":[],"effect":{"set":{},"add":{}},"narration":"option_answer_roll"},{"id":"wait_roll","text":"我跟同學核對名單，等老師再叫一次。","class":"misconception","safety":"unsafe","sourceIds":["cwa-school","moi-earthquake"],"steps":[{"kind":"hazard","id":"miss_roll_call"}],"cues":[],"effect":{"set":{},"add":{}},"narration":"option_wait_roll"},{"id":"go_back_after_roll","text":"我離開隊伍找小維，想和他一起回報。","class":"risk_or_delay","safety":"unsafe","sourceIds":["cwa-school","moi-earthquake"],"steps":[{"kind":"hazard","id":"leave_group_search"}],"cues":[],"effect":{"set":{},"add":{}},"narration":"option_go_back_after_roll"}]}
