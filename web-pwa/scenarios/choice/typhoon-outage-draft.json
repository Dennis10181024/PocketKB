      {"id":"typhoon_outage_act_risk","sourceIds":["outage"],"when":{"always":true},"review":{"why":"到門口詢問無法確認電力維修登記，也多接觸風雨。","tip":"留在安全室內，直接聯繫電力服務。","eligibleWhen":{"always":true},"priority":5,"principleId":"typhoon_outage_act_ok"},"normal":{"narration":"hazard_typhoon_outage_act_risk","effect":{"add":{"exposure.delay":1},"delay":"外出詢問耽擱停電報修"}}},
      {"id":"typhoon_help_act_myth","sourceIds":["urgent"],"when":{"always":true},"review":{"why":"電力服務不能替代有人不適時的緊急救援。","tip":"有人疑似中毒或需要救援，直接撥119。","eligibleWhen":{"always":true},"priority":6,"principleId":"typhoon_help_act_ok"},"normal":{"narration":"hazard_typhoon_help_act_myth","effect":{"add":{"exposure.delay":1},"delay":"先詢問復電耽擱緊急通報"}}},
