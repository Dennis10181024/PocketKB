  "decisions": [
    {"id":"typhoon_light","prompt":"室內突然變暗，手電筒和蠟燭就在桌上。我要怎麼在室內照明？","when":{"clock":{"eq":0}},"options":[{"id":"typhoon_light_ok","text":"我開手電筒，先照亮眼前的通道。","class":"correct","safety":"safe","sourceIds":["outage"],"steps":[{"kind":"principle","id":"typhoon_light_act_ok"}],"cues":[],"effect":{},"narration":"option_typhoon_light_ok"},{"id":"typhoon_light_myth","text":"我點一支蠟燭照走廊，再回房找東西。","class":"misconception","safety":"unsafe","sourceIds":["outage"],"steps":[{"kind":"hazard","id":"typhoon_light_act_myth"}],"cues":[],"effect":{},"narration":"option_typhoon_light_myth"},{"id":"typhoon_light_risk","text":"我摸黑走進走廊，找應急燈。","class":"risk_or_delay","safety":"unsafe","sourceIds":["outage"],"steps":[{"kind":"hazard","id":"typhoon_light_act_risk"}],"cues":[],"effect":{},"narration":"option_typhoon_light_risk"}]},
    {"id":"typhoon_plugs","prompt":"乾燥室內的電暖器和吹風機仍插著。我和小晴要離開這個房間，應怎麼處理？","when":{"clock":{"eq":1}},"options":[{"id":"typhoon_plugs_ok","text":"我拔下乾燥處的電暖器與吹風機插頭。","class":"correct","safety":"safe","sourceIds":["outage"],"steps":[{"kind":"principle","id":"typhoon_plugs_act_ok"}],"cues":[],"effect":{},"narration":"option_typhoon_plugs_ok"},{"id":"typhoon_plugs_myth","text":"我關掉電暖器，整理電線後把它移到牆邊。","class":"misconception","safety":"unsafe","sourceIds":["outage"],"steps":[{"kind":"hazard","id":"typhoon_plugs_act_myth"}],"cues":[],"effect":{},"narration":"option_typhoon_plugs_myth"},{"id":"typhoon_plugs_risk","text":"我留著暖器加熱檔，用外套蓋住。","class":"risk_or_delay","safety":"unsafe","sourceIds":["outage"],"steps":[{"kind":"hazard","id":"typhoon_plugs_act_risk"}],"cues":[],"effect":{},"narration":"option_typhoon_plugs_risk"}]},
    {"id":"typhoon_fumes","prompt":"屋外風雨強，門窗關著。小晴看見收納間有發電機和卡式爐，問晚餐怎麼辦？","when":{"clock":{"eq":2}},"options":[{"id":"typhoon_fumes_ok","text":"我選常溫備糧，和小晴待在安全處。","class":"correct","safety":"safe","sourceIds":["co"],"steps":[{"kind":"principle","id":"typhoon_fumes_act_ok"}],"cues":[],"effect":{},"narration":"option_typhoon_fumes_ok"},{"id":"typhoon_fumes_myth","text":"我在客廳用卡式爐煮一點熱食。","class":"misconception","safety":"unsafe","sourceIds":["co"],"steps":[{"kind":"hazard","id":"typhoon_fumes_act_myth"}],"cues":[],"effect":{},"narration":"option_typhoon_fumes_myth"},{"id":"typhoon_fumes_risk","text":"我把發電機放在窗邊，啟動來接電扇。","class":"risk_or_delay","safety":"unsafe","sourceIds":["co"],"steps":[{"kind":"hazard","id":"typhoon_fumes_act_risk"}],"cues":[],"effect":{},"narration":"option_typhoon_fumes_risk"},{"id":"typhoon_fumes_other","text":"我叫小晴等一下，去翻櫃子再找晚餐。","class":"risk_or_delay","safety":"unsafe","sourceIds":["co"],"steps":[{"kind":"hazard","id":"typhoon_fumes_act_other"}],"cues":[],"effect":{},"narration":"option_typhoon_fumes_other"}]},
    {"id":"typhoon_outage","prompt":"透過窗看見附近街廓也停電，眼前沒有火煙或傷者。要回報給誰？","when":{"clock":{"eq":3}},"options":[{"id":"typhoon_outage_ok","text":"我撥1911通報區域停電和地址。","class":"correct","safety":"safe","sourceIds":["outage"],"steps":[{"kind":"principle","id":"typhoon_outage_act_ok"}],"cues":[],"effect":{},"narration":"option_typhoon_outage_ok"},{"id":"typhoon_outage_myth","text":"我打119查復電，再請他轉報。","class":"misconception","safety":"unsafe","sourceIds":["outage"],"steps":[{"kind":"hazard","id":"typhoon_outage_act_myth"}],"cues":[],"effect":{},"narration":"option_typhoon_outage_myth"},{"id":"typhoon_outage_risk","text":"我到大門口察看，再問鄰居是否有人報修。","class":"risk_or_delay","safety":"unsafe","sourceIds":["outage"],"steps":[{"kind":"hazard","id":"typhoon_outage_act_risk"}],"cues":[],"effect":{},"narration":"option_typhoon_outage_risk"}]},
    {"id":"typhoon_help","prompt":"隔戶有人說頭暈、站不穩，屋內正在用燃料設備。我在安全通風的樓梯口，要怎麼求助？","when":{"clock":{"eq":4}},"options":[{"id":"typhoon_help_ok","text":"我在安全處撥119，回報位置與不適。","class":"correct","safety":"safe","sourceIds":["urgent"],"steps":[{"kind":"principle","id":"typhoon_help_act_ok"}],"cues":[],"effect":{},"narration":"option_typhoon_help_ok"},{"id":"typhoon_help_myth","text":"我先打1911問停電狀況，再找人求助。","class":"misconception","safety":"unsafe","sourceIds":["urgent"],"steps":[{"kind":"hazard","id":"typhoon_help_act_myth"}],"cues":[],"effect":{},"narration":"option_typhoon_help_myth"},{"id":"typhoon_help_risk","text":"我進隔戶查看，再把住戶帶出來。","class":"risk_or_delay","safety":"unsafe","sourceIds":["co"],"steps":[{"kind":"hazard","id":"typhoon_help_act_risk"}],"cues":[],"effect":{},"narration":"option_typhoon_help_risk"}]},
    {"id":"typhoon_fridge","prompt":"我回到安全處，冰箱已停電一段時間，桌上有常溫備糧。一盒牛奶摸起來已回到室溫。我要怎麼安排食物？","when":{"clock":{"eq":5}},"options":[{"id":"typhoon_fridge_ok","text":"我關好冰箱，改吃常溫保存的備糧。","class":"correct","safety":"safe","sourceIds":["outage"],"steps":[{"kind":"principle","id":"typhoon_fridge_act_ok"}],"cues":[],"effect":{},"narration":"option_typhoon_fridge_ok"},{"id":"typhoon_fridge_myth","text":"我打開冰箱逐層查看，先挑冷飲補充水分。","class":"misconception","safety":"unsafe","sourceIds":["outage"],"steps":[{"kind":"hazard","id":"typhoon_fridge_act_myth"}],"cues":[],"effect":{},"narration":"option_typhoon_fridge_myth"},{"id":"typhoon_fridge_risk","text":"我聞聞回溫牛奶，喝幾口確認味道。","class":"risk_or_delay","safety":"unsafe","sourceIds":["outage"],"steps":[{"kind":"hazard","id":"typhoon_fridge_act_risk"}],"cues":[],"effect":{},"narration":"option_typhoon_fridge_risk"}]},
