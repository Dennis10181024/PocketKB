    {"id":"handoff","prompt":"門外有人喊「503 有人嗎？」我怎麼回應？","when":{"fact":"firefightersHere","eq":true},"options":[{"id":"answer_rescuer","text":"我大聲回報房號人數，留在門內等候指示。","class":"correct","safety":"safe","sourceIds":["nfa"],"steps":[{"kind":"principle","id":"handoff"}],"cues":[],"effect":{},"narration":"option_answer_rescuer"},{"id":"wait_rescuer","text":"我貼近門邊聽清楚，再示意小岑安靜等候。","class":"misconception","safety":"unsafe","sourceIds":["nfa"],"steps":[{"kind":"principle","id":"wait_inside"}],"cues":[],"effect":{},"narration":"option_wait_rescuer"},{"id":"pack_rescuer","text":"我拿起房卡和手機，收好物品再回應。","class":"risk_or_delay","safety":"unsafe","sourceIds":["nfa"],"steps":[{"kind":"hazard","id":"pack_before_handoff"}],"cues":[],"effect":{},"narration":"option_pack_rescuer"}]},
