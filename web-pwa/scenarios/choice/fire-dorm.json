    {"id":"roommate","prompt":"小岑還站在門附近，擔心其他人沒收到警報。我怎麼回應？","when":{"clock":{"eq":1}},"options":[{"id":"help_roommate","text":"我請小岑留在房裡，陪我核對房號。","class":"correct","safety":"safe","sourceIds":["nfa","safety"],"steps":[{"kind":"principle","id":"stop_roommate"},{"kind":"principle","id":"reassure"}],"cues":[],"effect":{},"narration":"option_help_roommate"},{"id":"open_together","text":"我請小岑開門一點，再對隔壁喊一聲。","class":"misconception","safety":"unsafe","sourceIds":["nfa","safety"],"steps":[{"kind":"hazard","id":"open"}],"cues":[],"effect":{},"narration":"option_open_together"},{"id":"bathroom","text":"我叫小岑留在門邊，自己進浴室避煙。","class":"risk_or_delay","safety":"unsafe","sourceIds":["nfa"],"steps":[{"kind":"hazard","id":"bathroom"}],"cues":[],"effect":{},"narration":"option_bathroom"},{"id":"warn_only","text":"我提醒小岑別開門，拿起房卡做準備。","class":"partial","safety":"safe","sourceIds":["nfa","safety"],"steps":[{"kind":"principle","id":"stop_roommate"}],"cues":[],"effect":{},"narration":"option_warn_only","missingStep":"勸阻後可和小岑一起確認房號，讓她有一件具體的事可做。"}]},
