      {"id":"flood_wet_panel_act_ok","sourceIds":["power-flood"],"when":{"always":true},"review":{"why":"只要到電箱要經過積水，就不能自行接近。","tip":"留在乾處，往可通行的高處動線移動，交由專業人員處理供電。","eligibleWhen":{"always":true},"priority":3},"normal":{"narration":"principle_flood_wet_panel_act_ok","effect":{"set":{"facts.upper":true}}}},
      {"id":"flood_basement_act_ok","sourceIds":["wet-flood","county-flood"],"when":{"always":true},"review":{"why":"地下室可能快速進水，同行上樓也便於互相照應。","tip":"離開地下入口，勸同伴一起往二樓以上移動。","eligibleWhen":{"always":true},"priority":4},"normal":{"narration":"principle_flood_basement_act_ok","effect":{"set":{"facts.basementResolved":true,"npc.peer.state":"reassured"}}}},
      {"id":"flood_road_act_ok","sourceIds":["road-flood"],"when":{"always":true},"review":{"why":"道路深淺與流速看不清楚時留在高處較安全。","tip":"避開積水道路，在可及的高處待救。","eligibleWhen":{"always":true},"priority":5},"normal":{"narration":"principle_flood_road_act_ok","effect":{}}},
      {"id":"flood_call_act_ok","sourceIds":["call-flood"],"when":{"always":true},"review":{"why":"由手機報案先讓接線員取得可定位的資訊，再依詢問補充受困人數、樓層與水況。","tip":"通話先報門牌和所在樓層，接著回報人數、水勢及傷勢。","eligibleWhen":{"always":true},"priority":6},"normal":{"narration":"principle_flood_call_act_ok","effect":{"set":{"facts.called":true}}}},
      {"id":"flood_signal_act_ok","sourceIds":["wet-flood"],"when":{"always":true},"review":{"why":"在可見的安全高處示意，能幫助救援確認位置。","tip":"從安全可見的高處回應，保持在屋內，聽救援人員指示。","eligibleWhen":{"always":true},"priority":7},"normal":{"narration":"principle_flood_signal_act_ok","effect":{"set":{"facts.roofSignal":true}}}},
      {"id":"flood_recovery_act_ok","sourceIds":["power-flood"],"when":{"always":true},"review":{"why":"外表看乾也不能證明內部安全。","tip":"泡水設備應經專業檢查才能重新使用。","eligibleWhen":{"always":true},"priority":8},"normal":{"narration":"principle_flood_recovery_act_ok","effect":{}}},
