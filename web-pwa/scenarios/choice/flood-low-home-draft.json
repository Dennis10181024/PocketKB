  "decisions": [
    {"id":"flood_power","prompt":"雨聲蓋過排水口的聲音，屋內地板、手和總開關一帶仍乾燥。我先處理什麼？","when":{"clock":{"eq":0}},"options":[{"id":"flood_power_ok","text":"我確認乾燥，再切斷屋內總電源。","class":"correct","safety":"safe","sourceIds":["power-flood"],"steps":[{"kind":"principle","id":"flood_power_act_ok"}],"cues":[],"effect":{},"narration":"option_flood_power_ok"},{"id":"flood_power_myth","text":"我搬高延長線，再整理插頭。","class":"misconception","safety":"unsafe","sourceIds":["power-flood"],"steps":[{"kind":"hazard","id":"flood_power_act_myth"}],"cues":[],"effect":{},"narration":"option_flood_power_myth"},{"id":"flood_power_risk","text":"我開著電器先收拾物品，等雨停下。","class":"risk_or_delay","safety":"unsafe","sourceIds":["power-flood"],"steps":[{"kind":"hazard","id":"flood_power_act_risk"}],"cues":[],"effect":{},"narration":"option_flood_power_risk"}]},
    {"id":"flood_wet_panel","prompt":"門縫冒進一線混水，電箱前方已有積水；乾側的梯口仍看得見。我怎麼選？","when":{"clock":{"eq":1}},"options":[{"id":"flood_wet_panel_ok","text":"我避開電箱，往乾側梯口退。","class":"correct","safety":"safe","sourceIds":["power-flood"],"steps":[{"kind":"principle","id":"flood_wet_panel_act_ok"}],"cues":[],"effect":{},"narration":"option_flood_wet_panel_ok"},{"id":"flood_wet_panel_myth","text":"我在玄關鋪毛巾，再拿拖把吸水。","class":"misconception","safety":"unsafe","sourceIds":["power-flood"],"steps":[{"kind":"hazard","id":"flood_wet_panel_act_myth"}],"cues":[],"effect":{},"narration":"option_flood_wet_panel_myth"},{"id":"flood_wet_panel_risk","text":"我踩水走到電箱，想確認開關位置。","class":"risk_or_delay","safety":"unsafe","sourceIds":["power-flood","wet-flood"],"steps":[{"kind":"hazard","id":"flood_wet_panel_act_risk"},{"kind":"hazard","id":"flood_wet_panel_slip"}],"cues":[],"effect":{},"narration":"option_flood_wet_panel_risk"}]},
    {"id":"flood_basement","prompt":"坡道底湧出水聲。阿哲攥著車鑰匙，說再晚就來不及移車。我怎麼回他？","when":{"clock":{"eq":2}},"options":[{"id":"flood_basement_ok","text":"我陪阿哲退到梯口，請他留在乾處。","class":"correct","safety":"safe","sourceIds":["wet-flood","county-flood"],"steps":[{"kind":"principle","id":"flood_basement_act_ok"}],"cues":[],"effect":{},"narration":"option_flood_basement_ok"},{"id":"flood_basement_myth","text":"我站在乾處，先讓阿哲下去看。","class":"misconception","safety":"unsafe","sourceIds":["wet-flood","county-flood"],"steps":[{"kind":"hazard","id":"flood_basement_act_myth"}],"cues":[],"effect":{},"narration":"option_flood_basement_myth"},{"id":"flood_basement_risk","text":"我跟他走下車庫，想趁水淺把車移走。","class":"risk_or_delay","safety":"unsafe","sourceIds":["wet-flood","county-flood"],"steps":[{"kind":"hazard","id":"flood_basement_act_risk"}],"cues":[],"effect":{},"narration":"option_flood_basement_risk"}]},
    {"id":"flood_road","prompt":"巷口一輛車停下，水流遮住路面標線。鄰居喊說外面也許還能開出去。我怎麼判斷？","when":{"clock":{"eq":3}},"options":[{"id":"flood_road_ok","text":"我留在乾側，再找可走的樓梯。","class":"correct","safety":"safe","sourceIds":["road-flood"],"steps":[{"kind":"principle","id":"flood_road_act_ok"}],"cues":[],"effect":{},"narration":"option_flood_road_ok"},{"id":"flood_road_myth","text":"我留在門邊，等別的車先試。","class":"misconception","safety":"unsafe","sourceIds":["road-flood"],"steps":[{"kind":"hazard","id":"flood_road_act_myth"}],"cues":[],"effect":{},"narration":"option_flood_road_myth"},{"id":"flood_road_risk","text":"我去開車，沿別人的車道穿過積水。","class":"risk_or_delay","safety":"unsafe","sourceIds":["road-flood"],"steps":[{"kind":"hazard","id":"flood_road_act_risk"}],"cues":[],"effect":{},"narration":"option_flood_road_risk"}]},
